# Local development only. Copy to .env; never use these values in a hosted environment.
APP_ENV=development
POSTGRES_DB=verityai
POSTGRES_USER=verityai
POSTGRES_PASSWORD=verityai_local_only_change_me
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://verityai:verityai_local_only_change_me@127.0.0.1:5432/verityai
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DOCUMENT_STORAGE_PATH=var/knowledge-documents
DOCUMENT_MAX_UPLOAD_BYTES=10485760
DOCUMENT_CHUNK_SIZE=1200
DOCUMENT_CHUNK_OVERLAP=150
# Bind local ingestion routes to an existing tenant and member; callers cannot select these IDs.
DOCUMENT_TENANT_ORGANIZATION_ID=
DOCUMENT_TENANT_WORKSPACE_ID=
DOCUMENT_TENANT_MEMBERSHIP_ID=
